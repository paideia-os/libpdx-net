# libpdx-net -- shared-library dependencies (per design/networking/
# r100-user-tools-plan.md §2 + §12).
#
# Version:  authoritative for v0.1.0 (Wave N scaffold seed).
#
# Format:   <libname>  <version-constraint>  <status>  <notes>
#
# `status` is one of:
#   LANDED   -- the dependency has shipped a signed release we consume
#   PENDING  -- the dep exists as source but hasn't closed its M5 yet;
#               libpdx-net wires to the kernel primitive the dep will
#               eventually front, and the swap is source-compatible.
#   KERNEL   -- not a shared library; kernel primitive consumed directly.
#
# A PENDING entry is a documented forward reference, not a build
# blocker: every function that would go through the pending lib is
# present today with a direct kernel-primitive call marked as the
# swap site in the source.

libpdx-audit    >=1.1.2   PENDING   TlsHandshakeRecord@0.1 emission
                                    (M3-005, net_tls_record.pdx) mirrors
                                    the record through libpdx-audit's
                                    audit_append_leaf once the leaf's
                                    schema-tag path grows a TLS variant.
                                    At v0.1.0 the emit path is a stub
                                    (net_tls_record_emit_stub) that
                                    keeps a stable ABI at the emission
                                    site; the swap adds a `deps:` line
                                    in manifest.pdxproj + a caps.decl
                                    `requires: KIND_IPC_ENDPOINT(write,
                                    svc.audit-journal)` line + a body
                                    swap in net_tls_record.pdx.

libpdx-argv     >=1.1.3   PENDING   Wave 6 PDX_TOOL_NAME/PDX_TOOL_VERSION
                                    extern contract (see
                                    src/tool_ident.pdx). The scaffold
                                    seed defines both externs today
                                    even though no libpdx-net function
                                    consumes libpdx-argv yet -- the
                                    contract is symmetric with every
                                    other user-space tool in this org
                                    and the two symbols cost nothing
                                    to publish preemptively.

# Kernel primitives consumed directly (KERNEL -- not shared libraries):
#
#   sys_getpid                   -- SC+ ID 39; net_dns_txid.pdx
#                                    WEAK_ENTROPY_FALLBACK path only
#   sys_hpet_now_ns              -- SC+ ID 45; net_dns_txid.pdx
#                                    WEAK_ENTROPY_FALLBACK path only
#   sys_semantic_send            -- SC+ ID 115; TlsHandshakeRecord@0.1
#                                    emit path (M3-005) once the stub
#                                    lifts
#   sys_socket / connect / send / recv / close
#                                 -- SC+ IDs 87/91/92/93/3; LANDED at
#                                    v0.3.0 (net_tcp.pdx, M2-001 #4)
#   sys_bind / listen / accept   -- SC+ IDs 88/89/90; LANDED at v0.4.0
#                                    (net_server.pdx, M2-002 #5)
#   sys_setsockopt                -- SC+ ID 99; LANDED (WEAK, floor-only
#                                    no-op against the live kernel) at
#                                    v0.4.0 (net_resolve_udp.pdx,
#                                    M2-007 #10) -- see that file's own
#                                    WEAK_TIMEOUT_FLOOR header note.
#   sys_shutdown                  -- SC+ ID 94; NOT consumed -- no
#                                    milestone in this tree names it yet
#   ChaCha20Poly1305::seal/open  -- paideia-as intrinsic
#                                    (#1305/v0.33-004); CONSUMED FOR
#                                    REAL as of v0.5.0 (M3-004 #14,
#                                    net_tls_record.pdx). LINKABLE on
#                                    both required counts: extern-C
#                                    thunks `paideia_crypto_chacha20_
#                                    poly1305_{seal,open}` exist in
#                                    paideia-as-crypto::ffi, and
#                                    stdlib_lowering::cryptoops has the
#                                    matching dispatch arm. Reached via
#                                    a module-local `trait` redeclaration
#                                    + plain-lambda wrapper (the recipe
#                                    fires only on a call expression at
#                                    a lambda-body position, never from
#                                    inside an `unsafe` asm block) --
#                                    template: tools/user/libpdx-volume/
#                                    src/pdxb_crypto.pdx in paideia-os.
#                                    Carries @{paideia.crypto}; see
#                                    caps.decl's `requires:`.
#
#   Ed25519::verify              -- paideia-as intrinsic (extern symbol
#                                    `paideia_crypto_ed25519_verify`);
#                                    CONSUMED FOR REAL as of v0.6.0
#                                    (M3-003 #13, net_tls_verify.pdx).
#                                    LINKABLE on both required counts as
#                                    of paideia-as v0.36.2 (extern-C
#                                    thunk) + v0.36.3
#                                    (stdlib_lowering::cryptoops
#                                    `Ed25519` dispatch arm) -- both
#                                    landed the same wave as this
#                                    consumer. Reached via the same
#                                    module-local `trait` + plain-lambda
#                                    wrapper template as
#                                    ChaCha20Poly1305 above. Carries
#                                    @{paideia.crypto}; see caps.decl's
#                                    `requires:`. R100-PREP-001
#                                    (KIND_TLS_TRUST pubkey provenance)
#                                    remains open independently of this
#                                    entry.
#   Hkdf::sha256                 -- paideia-as intrinsic (extern symbol
#                                    `paideia_crypto_hkdf_sha256`);
#                                    CONSUMED FOR REAL as of v0.6.0
#                                    (M3-002 #12, net_tls_key_schedule.pdx).
#                                    LINKABLE on both required counts as
#                                    of paideia-as v0.36.2 (extern-C
#                                    thunk, covering extract/expand/
#                                    extract-and-expand via a `mode`
#                                    argument) + v0.36.3
#                                    (stdlib_lowering::cryptoops `Hkdf`
#                                    dispatch arm). Reached via the same
#                                    module-local `trait` + plain-lambda
#                                    wrapper template as
#                                    ChaCha20Poly1305 above. Carries
#                                    @{paideia.crypto}; see caps.decl's
#                                    `requires:`.
#
# All of the above are ambient except the paideia.crypto-gated crypto
# intrinsics (ChaCha20Poly1305, Ed25519, Hkdf), which propagate that
# capability to their `.pdx` callers -- see caps.decl.
