// src/tool_ident.pdx -- libpdx-net v0.1.0 (Wave N scaffold seed)
//
// ToolIdent module: per-tool identity externs consumed by libpdx-argv
// VersionBackend::emit_default (libpdx-argv Wave 6 ENH-032 contract).
//
// Why this file exists -- Wave 6 libpdx-argv contract
// ---------------------------------------------------
// libpdx-argv 1.1.3 removed the hard-coded `DOC_TOOL_NAME` /
// `DOC_TOOL_VERSION` literals from VersionBackend::emit_default and
// replaced them with two `UND` externs: PDX_TOOL_NAME (lowercase,
// NUL-terminated) and PDX_TOOL_VERSION (semver, NUL-terminated).
// Every consumer of libpdx-argv >= 1.1.3 must provide both symbols
// at final-link time or `ld` fails with an undefined-symbol error
// naming the missing symbol. There is deliberately no STB_WEAK
// fallback because the pre-hotfix "doc" default would silently pass
// under `--version` -- worse than a link-time failure.
//
// libpdx-net does not itself parse argv (it is a library, not a
// tool) but the two symbols are published preemptively so a future
// tool that statically links libpdx-net can rely on the symbol
// contract without a second definition site. See
// tools/user/cp/src/tool_ident.pdx in paideia-os for the mirror
// contract on the tool side.
//
// paideia-as compliance
// ---------------------
//   - Module name PascalCase basename (`ToolIdent`) matches file.
//   - No function bodies -> no register plan, no push/pop parity,
//     no encoder guardrails to enforce here.
//   - String literals on single lines (fingerprint-extractor
//     requirement + libpdx-argv linker resolves the symbol as-is).
//   - Array size == literal byte count INCLUDING NUL:
//       "libpdx-net\0"  = 11 bytes
//       "0.1.0\0"       =  6 bytes
//   - Both symbols `pub let` (public + immutable = .rodata) so the
//     linker can resolve libpdx-argv's UND refs against them.

module ToolIdent = structure {

  // ============================================================================
  // PDX_TOOL_NAME -- lowercase library name, NUL-terminated. Read by
  // libpdx-argv VersionBackend::emit_default at run time via the
  // `lea rdi, [rip + PDX_TOOL_NAME]` idiom.
  // ============================================================================
  pub let PDX_TOOL_NAME : [u8; 11] = "libpdx-net\0"

  // ============================================================================
  // PDX_TOOL_VERSION -- semver, NUL-terminated. Read by libpdx-argv
  // VersionBackend::emit_default at run time via `lea rdi, [rip +
  // PDX_TOOL_VERSION]`.
  //
  // v0.2.0 -- Wave X drain (libpdx-net#1/#2/#3/#21/#22): scaffold
  // witness + M1-002 public API stubs + M1-003 first-runnable
  // stub test + M5-001/M5-002 release-tool placeholders. Keep
  // this literal in lockstep with manifest.pdxproj `version`
  // and the top CHANGELOG.md entry.
  // ============================================================================
  pub let PDX_TOOL_VERSION : [u8; 6] = "0.2.0\0"

}
