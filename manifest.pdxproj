# libpdx-net -- paideia-as build manifest
#
# Wave:      R100  (client-side network SDK for PaideiaOS user tools)
# Milestone: Wave N scaffold seed -- M3-005/006 + M4-001/002/003 land
#            per-file pure-function schemas and encoders/decoders on
#            top of a fresh scaffold (README + LICENSE + this manifest).
# Doc:       design/networking/r100-user-tools-plan.md
#            (paideia-os monorepo) -- authoritative for API surface
#            (§2.1), TXID discipline (§2.3.1), TLS handshake record
#            wire format (§10.3), and HTTP/1.1 encode/decode scope
#            (§2.5). Milestone catalog at §13.1.
#
# The v0.1.0 scaffold seed intentionally ships stubs / pure functions
# / schema constants only: real socket + TLS handshake bodies are
# blocked on R100-PREP-002 (UDP-via-socket) and R100-PREP-005 (crypto
# intrinsics -- SHA-256/HKDF/X25519/Ed25519). Every function in this
# tag is either (a) a schema/offset constant module, (b) a pure
# function over caller-provided byte buffers, or (c) a fail-closed
# stub with a documented swap site once the upstream primitive lands
# -- the mkfs.pdxfs pattern (parses, does not transmit, ships anyway).

name        = libpdx-net
version     = 0.5.0
kind        = shared-library
output      = build-out/libpdx-net.a
caps_decl   = caps.decl

# --- Source list -------------------------------------------------------
# Order-insensitive; paideia-as resolves module deps from
# `module <Basename> = structure { ... }` headers. net_api.pdx's
# net_socket/connect/send/recv/close and net_inet_pton now CALL
# symbols defined in net_tcp.pdx / net_inet.pdx respectively --
# order-insensitivity means this list does not need to reflect that,
# but the final `ld` step needs every listed object in the archive.
sources:
  - src/tool_ident.pdx          # PDX_TOOL_NAME / PDX_TOOL_VERSION externs
  - src/net_types.pdx           # NetErr/DnsErr/TlsErr/HttpErr enum tags
  - src/net_api.pdx             # M1-002 public API stubs (#2); M2-001/M2-004 swaps
  - src/net_tls_record.pdx      # M3-005: TlsHandshakeRecord@0.1 schema + emit (#15)
                                #   + M3-004: ChaCha20-Poly1305 record layer (#14)
                                #     -- additive section in the SAME module; a
                                #     second `module NetTlsRecord` would be a
                                #     duplicate-symbol link failure, not a second
                                #     namespace (see that file's header).
  - src/net_dns_txid.pdx        # M3-006: resolver TXID randomize + verify (#16)
  - src/net_http_request.pdx    # M4-001 GET encode + M4-002 POST encode (#17/#18)
  - src/net_http_response.pdx   # M4-001 status-line + header decode (#17)
  - src/net_http_chunked.pdx    # M4-003 chunked transfer-encoding decode (#19)
  - src/net_tcp.pdx             # M2-001: real socket/connect/send/recv/close trampolines (#4)
  - src/net_endian.pdx          # M2-003: htons/ntohs/htonl/ntohl (#6)
  - src/net_inet.pdx            # M2-004: dotted-quad IPv4 parse engine (#7)
  - src/net_dns_query.pdx       # M2-005: DNS query builder (#8)
  - src/net_dns_parse.pdx       # M2-006: DNS response parser (#9)
  - src/net_server.pdx          # M2-002: real bind/listen/accept trampolines (#5)
  - src/net_resolve_udp.pdx     # M2-007: net_resolve UDP transport (#10)
  - src/net_http_redirect.pdx   # M4-004: redirect method-preservation matrix (#20)
  - src/net_tls_wrap.pdx        # M3-001: TLS 1.3 ClientHello (scaffold) (#11)
  - src/net_tls_key_schedule.pdx # M3-002: TLS 1.3 key schedule (scaffold) (#12)
  - src/net_tls_verify.pdx      # M3-003: Ed25519 transcript verify (scaffold) (#13)

# --- Library dependencies ---------------------------------------------
# libpdx-net at v0.2.0 depends on nothing outside the SC+ syscall
# floor. libpdx-audit is a soft dep (semantic-pipe emission target
# for TlsHandshakeRecord@0.1) -- the call is fronted by a local
# stub (net_tls_record_emit_stub) that keeps a stable ABI at the
# emission site; the real libpdx-audit satellite wire lands at a
# future minor bump once the schema is registered with the daemon.
deps: []

# --- Test targets ------------------------------------------------------
# M1-003 (#3) first-runnable stub test lives at
# tests/net_types_selftest.pdx; per-file object built alongside
# src/*.pdx by tools/build.sh. Table-driven property checks over
# every band are a future TESTS-wave add (issues TBD).
tests:
  - tests/net_types_selftest.pdx  # M1-003 (#3) enum band-invariant self-test

# --- Documentation targets --------------------------------------------
# .pdxdoc source lands at M5-001 alongside the first signed release.
docs: []
